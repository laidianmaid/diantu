# Database
DATABASE_URL=postgresql+asyncpg://diantu:diantu123@db:5432/diantu

# JWT
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Amap (高德)
# 服务端 Web 服务密钥（后端地理编码）
AMAP_KEY=your-amap-web-service-api-key
# JS API 密钥（前端加载地图，需在高德控制台绑定域名白名单）
AMAP_JS_KEY=your-amap-js-api-key
VITE_AMAP_JS_KEY=your-amap-js-api-key
# 安全密钥（jscode）— 仅后端代理使用，永不暴露给前端
AMAP_JSCODE=your-amap-jscode

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3

# Browser-side edge AI (optional)
# 留空时，前端会自动回退到 Ollama。
# 如需启用浏览器端 Gemma 4 E2B，请先将 3.42GB 单文件 GGUF 切成多个 <=512MB 分片，
# 然后把所有分片 URL 按顺序用英文逗号连接填在这里。
VITE_EDGE_MODEL_URLS=
VITE_EDGE_MODEL_SIZE_BYTES=3416118240

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# App
APP_NAME=来点妹抖吗？
FRONTEND_URL=http://localhost:5173

# Superadmin (auto-created on first startup)
SUPERADMIN_EMAIL=admin@diantu.local
SUPERADMIN_PASSWORD=changeme123
SUPERADMIN_USERNAME=superadmin
